# DeCognito Environment Configuration Example
# Copy this file to .env and configure your secret API keys

# Shodan API Key for IoT and infrastructure intelligence
SHODAN_API_KEY=your_shodan_api_key_here

# RapidAPI Key for multi-source OSINT lookups
RAPIDAPI_KEY=your_rapidapi_key_here

# Google Gemini API Key for AI synthesis
GEMINI_API_KEY=your_gemini_api_key_here

# Database URL
DATABASE_URL=sqlite:///./decongito.db
